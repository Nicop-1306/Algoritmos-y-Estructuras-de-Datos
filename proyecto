int[,] datos = new int[6, 6];
int[,] nums = new int[6, 6];
int aux = 2;
for (int filas=0; filas < datos.GetLength(0); filas++)
{
    for (int columnas = 0; columnas < datos.GetLength(1); columnas++)
    {
        if (columnas%2==0)
        {
            nums [filas,columnas] = 0;
        }
        else
        {
            nums[filas, columnas] = aux;
        }
        aux *= 2;
    }
}

for (int i = 0; i < nums.GetLength(0); i++)
{
    for (int j = 0; j < nums.GetLength(1); j++)
    {
        Console.Write($"{nums[i, j],4}");
    }
    Console.WriteLine();
}
